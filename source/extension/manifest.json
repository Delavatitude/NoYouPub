{
  "manifest_version": 3,
  "name": "NoYouPub",
  "version": "3.0.0",
  "description": "__MSG_extensionDescription__",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "i18n.js",
        "page_state.js",
        "youtube.js",
        "suggestions.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/noyoupub-violet-16.png",
    "32": "icons/noyoupub-violet-32.png",
    "48": "icons/noyoupub-violet-48.png",
    "128": "icons/noyoupub-violet-128.png"
  },
  "default_locale": "en",
  "web_accessible_resources": [
    {
      "resources": [
        "i18n-index.json",
        "_locales/en/messages.json",
        "_locales/fr/messages.json"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
